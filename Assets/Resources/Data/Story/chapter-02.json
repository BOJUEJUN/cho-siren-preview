{
  "SchemaVersion": 1,
  "Id": "chapter-02",
  "Title": "第 02 章 · 魅声海湾",
  "Chapter": "02",
  "Lines": [
    { "Label": "start", "Command": "bg", "Subject": "Art/Story/Scenes1019/stage-2-1" },
    { "Command": "bgm", "Subject": "bgm-static-approach" },
    { "Command": "show", "Subject": "feiyin", "Expression": "serious", "Position": "center" },
    { "Command": "say", "Subject": "feiyin", "Expression": "serious", "Text": "王座那一战之后，杂音没有消失——它往海边去了。" },
    { "Command": "say", "Subject": "producer", "Text": "海湾巨蛋？下个月的公演就在那里。" },
    { "Command": "say", "Subject": "feiyin", "Expression": "grin", "Text": "所以说，有人想抢在我们前面，把整座巨蛋变成「幻蚀」的猎场。" },
    { "Command": "show", "Subject": "xingli", "Expression": "determined", "Position": "right" },
    { "Command": "say", "Subject": "xingli", "Expression": "determined", "Text": "那些被侵蚀的歌声里……有我认识的声音。她们原本也是想登上舞台的人。" },
    { "Command": "choice", "Choices": [
      { "Text": "那就用我们的舞台，把她们的声音带回来。", "Jump": "rescue", "SetFlag": "ch2-rescue" },
      { "Text": "先保护好你们自己，这是经纪人的命令。", "Jump": "guard" }
    ] },

    { "Label": "rescue", "Command": "say", "Subject": "xingli", "Expression": "smile", "Text": "……嗯。这次，我想唱给她们听。" },
    { "Command": "jump", "Jump": "outro" },

    { "Label": "guard", "Command": "say", "Subject": "feiyin", "Expression": "grin", "Text": "命令收到。不过真到了台上，谁也拦不住星璃。" },
    { "Command": "jump", "Jump": "outro" },

    { "Label": "outro", "Command": "say", "Subject": "producer", "Text": "从码头开始。沿着栈桥，一站一站打到巨蛋。" },
    { "Command": "say", "Subject": "feiyin", "Expression": "serious", "Text": "全员，巡演开始。" },
    { "Command": "set", "Subject": "ch2-started", "Value": true },
    { "Command": "end" }
  ]
}
