# Keep Unity's text-serialized assets stable between Windows and macOS.
* text=auto

*.cs text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.uxml text eol=lf
*.uss text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Unity YAML assets are text and should remain diffable.
*.anim text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.lighting text eol=lf
*.mask text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.overrideController text eol=lf
*.physicsMaterial2D text eol=lf
*.physicMaterial text eol=lf
*.playable text eol=lf
*.prefab text eol=lf
*.preset text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.unity text eol=lf

# Binary assets must not be line-ending normalized or text-merged.
*.a binary
*.aar binary
*.blend binary
*.bmp binary
*.bundle binary
*.dll binary
*.dylib binary
*.fbx binary
*.flac binary
*.gif binary
*.jpeg binary
*.jpg binary
*.mp3 binary
*.mp4 binary
*.mov binary
*.ogg binary
*.otf binary
*.pdf binary
*.png binary
*.psd binary
*.so binary
*.tga binary
*.ttf binary
*.wav binary
*.webm binary
*.webp binary
*.woff binary
*.woff2 binary
*.zip binary
